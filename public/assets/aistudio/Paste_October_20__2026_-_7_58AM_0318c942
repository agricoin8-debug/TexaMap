<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Texarkana Live Map & Autonomous Agent Trace</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        brand: {
                            blue: '#2563eb',
                            cyan: '#06b6d4',
                            emerald: '#10b981',
                            darkBg: '#0b0f19',
                            darkCard: 'rgba(15, 23, 42, 0.85)',
                            border: 'rgba(255, 255, 255, 0.08)'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        #map {
            width: 100%;
            height: 100vh;
            z-index: 0;
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
        }
        .glass-panel-light {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 0, 0, 0.06);
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.1);
        }
        /* Custom map marker styles */
        .user-pulse-marker {
            position: relative;
        }
        .user-pulse-marker::before {
            content: '';
            position: absolute;
            width: 32px;
            height: 32px;
            background: rgba(37, 99, 235, 0.35);
            border-radius: 50%;
            top: -10px;
            left: -10px;
            animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        .user-pulse-dot {
            width: 12px;
            height: 12px;
            background-color: #2563eb;
            border: 2px solid white;
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(37, 99, 235, 0.8);
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.6); opacity: 1; }
            100% { transform: scale(2.2); opacity: 0; }
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-[#0b0f19] text-gray-100 font-sans overflow-hidden select-none">

    <!-- Map Canvas Container -->
    <div id="map"></div>

    <!-- Top Floating Search & Action Bar -->
    <div class="absolute top-5 left-4 right-4 md:left-6 md:w-[420px] z-10 space-y-3 pointer-events-none">
        <div class="pointer-events-auto glass-panel rounded-2xl flex items-center px-4 py-3 transition-all duration-300 hover:border-blue-500/40">
            <div class="w-8 h-8 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-400 mr-3">
                <i class="fa-solid fa-satellite-dish text-xs animate-pulse"></i>
            </div>
            <input id="searchInput" type="text" placeholder="Search Texarkana or set destination..." 
                   class="w-full bg-transparent border-none focus:outline-none text-sm text-gray-100 placeholder-gray-400 font-medium"
                   onclick="openDestinationModal()">
            <button onclick="openDestinationModal()" class="ml-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white px-4 py-2 rounded-xl text-xs font-semibold shadow-lg shadow-blue-500/25 transition flex items-center gap-2 group">
                <i class="fa-solid fa-route group-hover:rotate-12 transition-transform"></i>
                <span>Trace</span>
            </button>
        </div>

        <!-- Texarkana Quick Landmark Chips -->
        <div class="pointer-events-auto flex items-center space-x-2.5 overflow-x-auto no-scrollbar py-1">
            <button onclick="quickSelectLandmark('courtHouse')" class="whitespace-nowrap px-3.5 py-1.5 glass-panel text-xs font-medium rounded-xl hover:bg-white/10 transition flex items-center gap-2 text-gray-200">
                <i class="fa-solid fa-landmark text-blue-400"></i> State Line Post Office
            </button>
            <button onclick="quickSelectLandmark('tamut')" class="whitespace-nowrap px-3.5 py-1.5 glass-panel text-xs font-medium rounded-xl hover:bg-white/10 transition flex items-center gap-2 text-gray-200">
                <i class="fa-solid fa-graduation-cap text-indigo-400"></i> TAMU-Texarkana
            </button>
            <button onclick="quickSelectLandmark('springLake')" class="whitespace-nowrap px-3.5 py-1.5 glass-panel text-xs font-medium rounded-xl hover:bg-white/10 transition flex items-center gap-2 text-gray-200">
                <i class="fa-solid fa-tree text-emerald-400"></i> Spring Lake Park
            </button>
        </div>
    </div>

    <!-- Map Control Buttons (Zoom, Layer, Center) -->
    <div class="absolute top-5 right-4 z-10 flex flex-col space-y-2.5">
        <button onclick="toggleMapTile()" title="Toggle Map Style" class="w-11 h-11 glass-panel rounded-2xl flex items-center justify-center text-gray-300 hover:text-white hover:bg-white/10 transition shadow-lg">
            <i class="fa-solid fa-layer-group text-sm"></i>
        </button>
        <button onclick="centerOnTexarkana()" title="Recenter Map" class="w-11 h-11 glass-panel rounded-2xl flex items-center justify-center text-blue-400 hover:bg-white/10 transition shadow-lg">
            <i class="fa-solid fa-crosshairs text-base"></i>
        </button>
        <button onclick="toggleConsoleDrawer()" title="Toggle Backend Agent Console" class="w-11 h-11 bg-slate-900 border border-emerald-500/30 text-emerald-400 rounded-2xl flex items-center justify-center hover:bg-slate-800 transition shadow-lg relative group">
            <i class="fa-solid fa-terminal text-sm"></i>
            <span id="agentStatusDot" class="absolute top-2 right-2 w-2.5 h-2.5 bg-emerald-400 rounded-full shadow-[0_0_8px_#10b981] animate-ping"></span>
        </button>
    </div>

    <!-- Active Map Trace Navigation Dashboard Card -->
    <div id="traceDashboard" class="hidden absolute top-24 md:top-24 right-4 left-4 md:left-auto md:w-88 z-10 glass-panel rounded-3xl p-5 transition-all duration-300">
        <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <div class="flex items-center gap-2.5">
                <span class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                </span>
                <span class="text-xs font-bold tracking-wider text-emerald-400 uppercase font-mono">Live Agent Telemetry</span>
            </div>
            <button onclick="stopTrace()" class="text-gray-400 hover:text-red-400 transition p-1">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <div class="mt-4 space-y-4">
            <div>
                <p class="text-[10px] text-gray-400 uppercase font-mono tracking-wider">Destination Target</p>
                <p id="dashDestName" class="font-bold text-gray-100 truncate text-sm mt-0.5">Texarkana Courthouse</p>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-3 gap-2 bg-black/30 p-3 rounded-2xl border border-white/5 text-center">
                <div>
                    <span class="block text-[9px] text-gray-400 uppercase font-mono">Est. Time</span>
                    <span id="dashEta" class="font-extrabold text-gray-100 text-xs mt-1 block">-- min</span>
                </div>
                <div class="border-x border-white/10">
                    <span class="block text-[9px] text-gray-400 uppercase font-mono">Distance</span>
                    <span id="dashDist" class="font-extrabold text-blue-400 text-xs mt-1 block">-- mi</span>
                </div>
                <div>
                    <span class="block text-[9px] text-gray-400 uppercase font-mono">Velocity</span>
                    <span id="dashSpeed" class="font-extrabold text-emerald-400 text-xs mt-1 block">0 mph</span>
                </div>
            </div>

            <!-- Share Button -->
            <button onclick="copyShareableLink()" class="w-full bg-blue-600/20 hover:bg-blue-600/30 border border-blue-500/30 text-blue-300 py-2.5 px-3 rounded-xl font-semibold text-xs transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-share-nodes"></i>
                <span>Copy Live Location Link</span>
            </button>
        </div>
    </div>

    <!-- Backend Agent Telemetry Console Drawer -->
    <div id="consoleDrawer" class="fixed bottom-0 left-0 right-0 z-20 bg-[#070a12]/95 backdrop-blur-2xl border-t border-emerald-500/20 shadow-2xl transition-transform duration-300 transform translate-y-full max-h-72 flex flex-col font-mono text-xs">
        <div class="bg-black/40 px-5 py-3 flex items-center justify-between border-b border-white/10">
            <div class="flex items-center gap-2.5">
                <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                <span class="font-bold text-gray-200 text-xs tracking-wider">BACKEND AGENT KERNEL & TELEMETRY STREAM</span>
                <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded-full">ACTIVE</span>
            </div>
            <div class="flex items-center gap-4">
                <button onclick="clearAgentLogs()" class="text-gray-400 hover:text-gray-200 text-xs">Clear Stream</button>
                <button onclick="toggleConsoleDrawer()" class="text-gray-400 hover:text-white">
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
            </div>
        </div>
        <div id="consoleLogs" class="p-4 overflow-y-auto space-y-1.5 h-52 text-[11px] leading-relaxed text-emerald-400/90">
            <!-- Dynamic logs inserted here -->
        </div>
    </div>

    <!-- Destination Selection Modal -->
    <div id="destinationModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="glass-panel w-full max-w-md rounded-3xl overflow-hidden shadow-2xl animate-in fade-in zoom-in duration-200 border border-white/10">
            <div class="p-5 border-b border-white/10 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-blue-600/20 flex items-center justify-center text-blue-400 border border-blue-500/30">
                        <i class="fa-solid fa-location-crosshairs"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-100 text-sm">Configure Route Destination</h3>
                        <p class="text-xs text-gray-400">Initialize autonomous agent trace in Texarkana</p>
                    </div>
                </div>
                <button onclick="closeDestinationModal()" class="text-gray-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <div class="space-y-3">
                    <div>
                        <label class="block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider mb-1.5">Origin Anchor</label>
                        <div class="flex items-center bg-black/30 rounded-2xl px-3.5 py-2.5 border border-white/5 text-xs">
                            <i class="fa-solid fa-circle text-blue-500 mr-3 text-[8px] animate-ping"></i>
                            <input id="originInput" type="text" value="Downtown Texarkana Core" readonly class="bg-transparent w-full focus:outline-none text-gray-300 font-medium cursor-not-allowed">
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider mb-1.5">Destination Target</label>
                        <div class="flex items-center bg-black/50 rounded-2xl px-3.5 py-2.5 border border-blue-500/40 ring-2 ring-blue-500/20 text-xs">
                            <i class="fa-solid fa-location-dot text-rose-500 mr-3"></i>
                            <input id="modalDestInput" type="text" placeholder="Search or select landmark below..." 
                                   class="bg-transparent w-full focus:outline-none text-gray-100 font-medium placeholder-gray-500">
                        </div>
                    </div>
                </div>

                <!-- Suggestions -->
                <div>
                    <span class="block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider mb-2">Regional Landmarks</span>
                    <div class="space-y-2 max-h-52 overflow-y-auto no-scrollbar">
                        <div onclick="selectPresetDestination('courtHouse')" class="p-3 bg-white/5 hover:bg-white/10 rounded-2xl cursor-pointer transition flex items-center justify-between border border-white/5">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-400">
                                    <i class="fa-solid fa-building-columns text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-semibold text-gray-200">State Line Post Office & Courthouse</p>
                                    <p class="text-[10px] text-gray-400 font-mono">500 N State Line Ave</p>
                                </div>
                            </div>
                            <i class="fa-solid fa-chevron-right text-xs text-gray-500"></i>
                        </div>

                        <div onclick="selectPresetDestination('tamut')" class="p-3 bg-white/5 hover:bg-white/10 rounded-2xl cursor-pointer transition flex items-center justify-between border border-white/5">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-400">
                                    <i class="fa-solid fa-graduation-cap text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-semibold text-gray-200">Texas A&M University - Texarkana</p>
                                    <p class="text-[10px] text-gray-400 font-mono">7101 University Ave</p>
                                </div>
                            </div>
                            <i class="fa-solid fa-chevron-right text-xs text-gray-500"></i>
                        </div>

                        <div onclick="selectPresetDestination('springLake')" class="p-3 bg-white/5 hover:bg-white/10 rounded-2xl cursor-pointer transition flex items-center justify-between border border-white/5">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400">
                                    <i class="fa-solid fa-tree text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-semibold text-gray-200">Spring Lake Park</p>
                                    <p class="text-[10px] text-gray-400 font-mono">4303 N Park Rd</p>
                                </div>
                            </div>
                            <i class="fa-solid fa-chevron-right text-xs text-gray-500"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="p-4 bg-black/40 border-t border-white/10 flex justify-end gap-2.5">
                <button onclick="closeDestinationModal()" class="px-4 py-2.5 text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-xl transition">Cancel</button>
                <button onclick="confirmAndStartTrace()" class="px-5 py-2.5 text-xs font-semibold bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white rounded-xl shadow-lg shadow-blue-500/30 transition flex items-center gap-2">
                    <span>Initialize Trace</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 glass-panel text-white px-5 py-3 rounded-2xl shadow-2xl text-xs font-medium flex items-center gap-3 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 border border-blue-500/30">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toastMsg">Notification message</span>
    </div>

    <!-- Main JavaScript Logic -->
    <script>
        const TEXARKANA_CENTER = [33.4251, -94.0477];
        
        const PRESET_LANDMARKS = {
            downtown: { name: "Downtown Texarkana Origin", coords: [33.4251, -94.0477] },
            courtHouse: { name: "State Line Post Office & Courthouse", coords: [33.4253, -94.0430] },
            tamut: { name: "Texas A&M University - Texarkana", coords: [33.4735, -94.1165] },
            springLake: { name: "Spring Lake Park", coords: [33.4601, -94.0674] },
            wrightPatman: { name: "Wright Patman Lake", coords: [33.2970, -94.1685] }
        };

        let map;
        let activeTileLayer;
        let isDarkTile = true;
        
        let activeTrace = null;
        let liveMarker = null;
        let routePolyline = null;
        let destinationMarker = null;
        let traceInterval = null;
        
        let selectedDestination = PRESET_LANDMARKS.courtHouse;

        window.onload = function() {
            const darkTileUrl = 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png';
            const lightTileUrl = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';

            map = L.map('map', {
                zoomControl: false,
                attributionControl: false
            }).setView(TEXARKANA_CENTER, 13);

            activeTileLayer = L.tileLayer(darkTileUrl, {
                maxZoom: 19,
                subdomains: 'abcd'
            }).addTo(map);

            initUserOriginMarker(TEXARKANA_CENTER);
            logAgent('SYSTEM_BOOT', 'Autonomous agent cluster online. Region locked: Texarkana [33.4251, -94.0477].');
            checkSharedTraceUrl();
        };

        function initUserOriginMarker(coords) {
            const userPulseIcon = L.divIcon({
                className: 'user-pulse-marker',
                html: '<div class="user-pulse-dot"></div>',
                iconSize: [12, 12],
                iconAnchor: [6, 6]
            });
            L.marker(coords, { icon: userPulseIcon }).addTo(map)
                .bindPopup("<b>Agent Origin Anchor</b><br>Texarkana Core");
        }

        function toggleMapTile() {
            isDarkTile = !isDarkTile;
            const newUrl = isDarkTile 
                ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
                : 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
            
            map.removeLayer(activeTileLayer);
            activeTileLayer = L.tileLayer(newUrl, { maxZoom: 19, subdomains: 'abcd' }).addTo(map);
            showToast(isDarkTile ? "Dark Cybernetic Map Active" : "Light Precision Map Active");
            logAgent('MAP_RENDER', `Tile layer updated. Scheme: ${isDarkTile ? 'Dark Cyber' : 'Light Clean'}`);
        }

        function centerOnTexarkana() {
            map.flyTo(TEXARKANA_CENTER, 13, { duration: 1.2 });
            showToast("Centered on Texarkana Matrix");
        }

        function openDestinationModal() {
            document.getElementById('destinationModal').classList.remove('hidden');
            logAgent('UI_EVENT', 'Destination configuration modal requested.');
        }

        function closeDestinationModal() {
            document.getElementById('destinationModal').classList.add('hidden');
        }

        function selectPresetDestination(key) {
            if (PRESET_LANDMARKS[key]) {
                selectedDestination = PRESET_LANDMARKS[key];
                document.getElementById('modalDestInput').value = selectedDestination.name;
                showToast(`Target Set: ${selectedDestination.name}`);
                logAgent('TARGET_LOCKED', `Preset selected: ${selectedDestination.name}`);
            }
        }

        function quickSelectLandmark(key) {
            selectPresetDestination(key);
            startAgentTrace();
        }

        function confirmAndStartTrace() {
            const customVal = document.getElementById('modalDestInput').value.trim();
            if (customVal && customVal !== selectedDestination.name) {
                selectedDestination = {
                    name: customVal,
                    coords: [33.4251 + (Math.random() - 0.5) * 0.08, -94.0477 + (Math.random() - 0.5) * 0.08]
                };
            }
            closeDestinationModal();
            startAgentTrace();
        }

        function startAgentTrace() {
            stopTrace();

            const startCoords = TEXARKANA_CENTER;
            const endCoords = selectedDestination.coords;

            logAgent('ROUTING_ENGINE', `Calculating vectorized route from [${startCoords.join(', ')}] to [${endCoords.join(', ')}]...`);

            const waypoints = generateInterpolatedWaypoints(startCoords, endCoords, 60);

            const destIcon = L.divIcon({
                className: 'custom-dest-pin',
                html: '<div style="color: #f43f5e; font-size: 26px; filter: drop-shadow(0 0 8px rgba(244,63,94,0.6));"><i class="fa-solid fa-location-dot"></i></div>',
                iconSize: [26, 26],
                iconAnchor: [13, 26]
            });
            destinationMarker = L.marker(endCoords, { icon: destIcon }).addTo(map)
                .bindPopup(`<b>Destination Target</b><br>${selectedDestination.name}`);

            routePolyline = L.polyline(waypoints, {
                color: '#2563eb',
                weight: 5,
                opacity: 0.9,
                dashArray: '2, 10'
            }).addTo(map);

            map.fitBounds(routePolyline.getBounds(), { padding: [60, 60] });

            const agentIcon = L.divIcon({
                className: 'custom-agent-icon',
                html: '<div style="background: #2563eb; color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px rgba(37,99,235,0.8); border: 2px solid white;"><i class="fa-solid fa-location-arrow text-xs"></i></div>',
                iconSize: [30, 30],
                iconAnchor: [15, 15]
            });
            liveMarker = L.marker(startCoords, { icon: agentIcon }).addTo(map);

            document.getElementById('traceDashboard').classList.remove('hidden');
            document.getElementById('dashDestName').innerText = selectedDestination.name;

            let step = 0;
            const totalSteps = waypoints.length;
            const totalDistance = calculateDistanceMiles(startCoords, endCoords);

            logAgent('TELEMETRY_STREAM', `Live stream initiated. Vector distance: ${totalDistance.toFixed(2)} mi.`);

            traceInterval = setInterval(() => {
                if (step >= totalSteps) {
                    clearInterval(traceInterval);
                    logAgent('MISSION_COMPLETE', `Target destination reached successfully: ${selectedDestination.name}`);
                    showToast("Agent Arrived at Destination!");
                    document.getElementById('dashEta').innerText = "0 min";
                    document.getElementById('dashDist').innerText = "0.0 mi";
                    document.getElementById('dashSpeed').innerText = "0 mph";
                    return;
                }

                const currentPos = waypoints[step];
                liveMarker.setLatLng(currentPos);

                const remainingRatio = 1 - (step / totalSteps);
                const distRem = totalDistance * remainingRatio;
                const simulatedSpeed = Math.floor(38 + Math.random() * 10);
                const etaMinutes = Math.ceil((distRem / simulatedSpeed) * 60);

                document.getElementById('dashDist').innerText = `${distRem.toFixed(1)} mi`;
                document.getElementById('dashEta').innerText = `${etaMinutes} min`;
                document.getElementById('dashSpeed').innerText = `${simulatedSpeed} mph`;

                if (step % 10 === 0) {
                    logAgent('VECTOR_UPDATE', `Lat: ${currentPos[0].toFixed(4)}, Lng: ${currentPos[1].toFixed(4)} | Vel: ${simulatedSpeed}mph | Rem: ${distRem.toFixed(2)}mi`);
                }

                step++;
            }, 600);

            activeTrace = {
                destName: selectedDestination.name,
                destCoords: endCoords,
                originCoords: startCoords
            };
        }

        function stopTrace() {
            if (traceInterval) clearInterval(traceInterval);
            if (routePolyline) map.removeLayer(routePolyline);
            if (destinationMarker) map.removeLayer(destinationMarker);
            if (liveMarker) map.removeLayer(liveMarker);

            document.getElementById('traceDashboard').classList.add('hidden');
            activeTrace = null;
            logAgent('TERMINATE', 'Active trace session aborted by operator.');
        }

        function generateInterpolatedWaypoints(start, end, steps) {
            const points = [];
            for (let i = 0; i <= steps; i++) {
                const t = i / steps;
                const curveFactor = Math.sin(t * Math.PI) * 0.005;
                const lat = start[0] + (end[0] - start[0]) * t + curveFactor;
                const lng = start[1] + (end[1] - start[1]) * t;
                points.push([lat, lng]);
            }
            return points;
        }

        function calculateDistanceMiles(coord1, coord2) {
            const R = 3958.8;
            const dLat = (coord2[0] - coord1[0]) * Math.PI / 180;
            const dLng = (coord2[1] - coord1[1]) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(coord1[0] * Math.PI / 180) * Math.cos(coord2[0] * Math.PI / 180) *
                      Math.sin(dLng/2) * Math.sin(dLng/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return R * c;
        }

        function copyShareableLink() {
            if (!activeTrace) return;

            const payload = encodeURIComponent(JSON.stringify({
                dest: activeTrace.destName,
                lat: activeTrace.destCoords[0],
                lng: activeTrace.destCoords[1]
            }));

            const shareUrl = `${window.location.origin}${window.location.pathname}?trace=${payload}`;

            const tempInput = document.createElement('input');
            tempInput.value = shareUrl;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showToast("Secure Trace Link Copied to Clipboard!");
            logAgent('STATE_SYNC', `Payload synchronized to URL: ${shareUrl}`);
        }

        function checkSharedTraceUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            const traceParam = urlParams.get('trace');
            if (traceParam) {
                try {
                    const data = JSON.parse(decodeURIComponent(traceParam));
                    selectedDestination = {
                        name: data.dest,
                        coords: [data.lat, data.lng]
                    };
                    showToast(`Loaded Shared Trace: ${data.dest}`);
                    logAgent('SHARED_PAYLOAD', `Decoded incoming trace target: ${data.dest}`);
                    setTimeout(() => startAgentTrace(), 1000);
                } catch (e) {
                    console.error("Payload parse error", e);
                }
            }
        }

        function toggleConsoleDrawer() {
            document.getElementById('consoleDrawer').classList.toggle('translate-y-full');
        }

        function logAgent(tag, text) {
            const consoleLogs = document.getElementById('consoleLogs');
            const time = new Date().toLocaleTimeString();
            const logEntry = document.createElement('div');
            logEntry.className = 'font-mono text-[11px] leading-tight flex items-start gap-2';
            logEntry.innerHTML = `<span class="text-gray-500">[${time}]</span> <span class="text-cyan-400 font-bold">[${tag}]</span> <span class="text-gray-300">${text}</span>`;
            
            consoleLogs.appendChild(logEntry);
            consoleLogs.scrollTop = consoleLogs.scrollHeight;
        }

        function clearAgentLogs() {
            document.getElementById('consoleLogs').innerHTML = '';
            logAgent('KERNEL', 'Stream buffer cleared.');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
                toast.classList.remove('opacity-100', 'translate-y-0');
            }, 3000);
        }
    </script>
</body>
